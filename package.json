{
  "name": "accel-scope",
  "version": "0.1.0",
  "description": "Self-hosted AI code and data auditor: point it at your repos and data, get an evidence-backed report and a fix plan your coding agent can run.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-theresa-lab/accel-scope-oss.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.7"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/server.ts",
    "serve": "node --disable-warning=ExperimentalWarning --experimental-strip-types src/server.ts",
    "analyze": "node --experimental-strip-types src/cli.ts",
    "analyze:org": "node --experimental-strip-types src/cli-org.ts",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check:english": "node scripts/check-english.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.167",
    "@google-cloud/bigquery": "^8.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
