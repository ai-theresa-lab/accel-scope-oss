# Copy to .env and fill in. `npm start` loads .env from the working directory (real environment variables win).

# Required: an Anthropic API key (sk-ant-api...) or a Claude plan token from `claude setup-token` (sk-ant-oat...).
ANTHROPIC_API_KEY=

# Optional: report writing / QC judges / reconciliation use OpenAI when set and fall back to Claude otherwise.
OPENAI_API_KEY=

# Optional settings (defaults shown).
# PORT=4317
# HOST=127.0.0.1
# THERESA_DATA_DIR=./.data
# THERESA_RUN_BUDGET=20
# THERESA_TELEMETRY=1
